---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const title = 'Contact | Pinto Injury Resources';
const description =
  'Pinto Injury Resources is an informational website operated by a law student. This site does not provide legal advice and does not accept messages or requests for assistance.';
const canonical = 'https://pintoinjury.com/contact/';
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} canonical={canonical} />
  </head>

  <body>
    <Header />

    <main class="container" style="padding: 3rem 1rem;">
      <header style="max-width: 75ch;">
        <h1 style="margin: 0 0 0.75rem 0;">Contact</h1>

        <div class="surface" style="padding: 1.25rem;">
          <p style="margin: 0 0 0.75rem 0;">
            <strong>Important:</strong> Pinto Injury Resources is an informational website operated by a law student.
            It is <strong>not a law firm</strong> and does <strong>not</strong> provide legal advice, legal opinions,
            legal representation, or individualized guidance.
          </p>

          <p style="margin: 0;">
            This website does <strong>not</strong> accept messages, case information, or requests for assistance.
            Nothing submitted through this site is confidential, and reading this site does not create an
            attorney–client relationship.
          </p>
        </div>
      </header>

      <section class="surface" style="padding: 1.25rem; margin-top: 1.25rem; max-width: 75ch;">
        <h2 style="margin: 0 0 0.5rem 0;">Need help with a specific situation?</h2>

        <p style="margin: 0.5rem 0; opacity: 0.95;">
          If you need advice about your specific facts, you should consult a licensed California attorney.
          This website provides general educational information only.
        </p>

        <p style="margin: 1rem 0 0 0;">
          <a class="btn" href="/resources">Browse injury resources</a>
          <a class="btn" href="/" style="margin-left: 0.5rem;">Return to homepage</a>
        </p>
      </section>

      <section class="surface" style="padding: 1.25rem; margin-top: 1.25rem; max-width: 75ch;">
        <p style="margin: 0; font-size: 0.95rem; opacity: 0.85;">
          <strong>Notice:</strong> This site is for general educational purposes only. It does not provide legal advice
          and does not create an attorney–client relationship.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>