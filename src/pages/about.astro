---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'About This Site | Pinto Injury Resources';
const description =
  'About Pinto Injury Resources — an informational website operated by a law student providing general information about California personal injury claims.';
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />

    <main class="wrap">
      <header class="hero">
        <h1>About This Site</h1>
        <p class="lede">
          Pinto Injury Resources is an informational website created to help people better
          understand the personal injury insurance claim process in California.
        </p>
      </header>

      <section class="card">
        <h2>What this site is</h2>
        <p>
          This website provides <strong>general educational information</strong> about personal
          injury claims, insurance processes, and common issues people face after an accident.
          It is designed to help visitors become more informed as they consider their options.
        </p>
        <p>
          The content on this site is intended to be clear, practical, and accessible, without
          pressure or sales tactics.
        </p>
      </section>

      <section class="card">
        <h2>What this site is not</h2>
        <p>
          Pinto Injury Resources is <strong>not a law firm</strong> and does not provide legal
          advice, legal opinions, or legal representation.
        </p>
        <p>
          This site is operated by a <strong>law student</strong>, not a licensed attorney.
          Visiting this site, reading its content, or contacting the site does not create an
          attorney–client relationship.
        </p>
      </section>

      <section class="card">
        <h2>About attorney referrals</h2>
        <p>
          In some situations, visitors may request help identifying independent, licensed
          California attorneys who handle personal injury matters.
        </p>
        <p>
          Any attorney referrals are made solely as a convenience to the visitor.
          <strong>No referral fees are accepted or paid</strong>, and this site does not endorse,
          control, or supervise the services provided by any attorney.
        </p>
        <p>
          Attorneys who may be referenced or contacted through this site operate independently
          and are responsible for their own legal services and advice.
        </p>
      </section>

      <section class="card">
        <h2>Important notice</h2>
        <p>
          All information provided on this website is for <strong>general educational purposes
          only</strong>. It should not be relied upon as a substitute for advice from a licensed
          attorney who can evaluate the specific facts of a situation.
        </p>
        <p>
          Laws, procedures, and insurance practices can change, and outcomes depend on individual
          circumstances.
        </p>
      </section>

      <section class="card">
        <p class="closing">
          If you have questions about the content of this site or its purpose, you are welcome
          to reach out for a no-pressure conversation focused on general information only.
        </p>
      </section>
    </main>

    <Footer />

    <style>
      .wrap {
        max-width: 900px;
        margin: 0 auto;
        padding: 3rem 1.25rem 4rem;
      }
      .hero h1 {
        font-size: clamp(32px, 4vw, 44px);
        line-height: 1.15;
        margin: 0 0 0.75rem 0;
        letter-spacing: -0.02em;
      }
      .lede {
        font-size: 1.125rem;
        line-height: 1.7;
        max-width: 75ch;
        margin: 0;
        opacity: 0.92;
      }
      .card {
        margin-top: 1.25rem;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 14px;
        padding: 1.25rem;
        background: white;
      }
      h2 {
        font-size: 1.1rem;
        margin: 0 0 0.5rem 0;
        letter-spacing: -0.01em;
      }
      p {
        margin: 0.5rem 0;
        line-height: 1.7;
      }
      .closing {
        margin: 0;
        opacity: 0.9;
      }
    </style>
  </body>
</html>
