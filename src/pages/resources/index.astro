---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const title = `Resources | Pinto Injury Law`;
const description =
  'Plain-English California personal injury resources for Ontario, Upland, and Rancho Cucamonga. Learn the insurance process and what to do after an injury.';
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />

    <main class="container" style="padding: 3rem 1rem;">
      <header style="max-width: 70ch;">
        <h1 style="font-size: 2rem; line-height: 1.2; margin-bottom: 0.75rem;">
          Injury Resources
        </h1>
        <p style="font-size: 1.125rem; opacity: 0.9; margin: 0;">
          Clear, practical information about the insurance claim process in California—written for injured people in
          Ontario, Upland, and Rancho Cucamonga.
        </p>
      </header>

      <section style="margin-top: 2rem;">
        <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Start here</h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
          <a class="card" href="/resources/what-to-do-after-a-car-accident-california" style="display:block; padding:1rem; border:1px solid rgba(255,255,255,0.15); border-radius:12px; text-decoration:none;">
            <h3 style="margin:0 0 0.5rem 0;">What to do after a car accident</h3>
            <p style="margin:0; opacity:0.85;">A calm checklist for the first 24 hours and the first week.</p>
          </a>

          <a class="card" href="/resources/insurance-adjuster" style="display:block; padding:1rem; border:1px solid rgba(255,255,255,0.15); border-radius:12px; text-decoration:none;">
            <h3 style="margin:0 0 0.5rem 0;">Talking to the insurance adjuster</h3>
            <p style="margin:0; opacity:0.85;">What to say, what not to guess, and how to protect your claim.</p>
          </a>

          <a class="card" href="/resources/medical-treatment" style="display:block; padding:1rem; border:1px solid rgba(255,255,255,0.15); border-radius:12px; text-decoration:none;">
            <h3 style="margin:0 0 0.5rem 0;">Medical treatment and documentation</h3>
            <p style="margin:0; opacity:0.85;">How gaps in care and missing records can affect settlement value.</p>
          </a>
        </div>

        <p style="margin-top: 1rem; opacity: 0.85;">
          These links can be placeholders for now—we’ll create the first article next.
        </p>
      </section>

      <section style="margin-top: 2.5rem; max-width: 75ch;">
        <h2 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Want help with your specific situation?</h2>
        <p style="margin:0 0 1rem 0; opacity:0.9;">
          If you’re injured and deciding what to do next, you can reach out for a no-pressure conversation.
        </p>
        <a href="/contact" style="display:inline-block; padding:0.75rem 1rem; border-radius:10px; border:1px solid rgba(255,255,255,0.2); text-decoration:none;">
          Contact Pinto Injury Law
        </a>
      </section>

      <section style="margin-top: 2.5rem; max-width: 75ch; opacity: 0.85;">
        <p style="margin:0;">
          <strong>Important:</strong> This website provides general information, not legal advice. Reading this does not create an attorney-client relationship.
        </p>
      </section>
    </main>

    <Footer />
  </body>
</html>
