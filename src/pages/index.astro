---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1>Understanding Personal Injury Claims Before a Lawsuit Is Filed</h1>
      <p class="subhead">
        Clear, practical information about personal injury claims in
        <strong>Ontario, Upland, and Rancho Cucamonga, California</strong>.
      </p>
<p class="fineprint">
  This site is an informational resource operated by a law student, not a law firm.
  It does not provide legal advice or representation.
</p>

      <ul class="bullets">
        <li>Focused on <strong>pre-litigation</strong> injury claim information</li>
        <li>Straightforward explanations of the <strong>insurance process</strong></li>
        <li>General information about <strong>California personal injury rules</strong></li>
        <li>No obligation, no pressure conversations</li>
      </ul>

      <div class="cta">
        <a class="btn btn-primary" href="/contact">Learn About Your Injury Claim</a>
<a class="link" href="/resources">Browse injury resources &rarr;</a>

      </div>

      <p class="fineprint">
        Information on this site is general and for educational purposes only. It is not legal advice, and 
        no attorney–client relationship is created.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container">
      <h2>How Pre-Litigation Injury Claims Typically Work</h2>
      <ol class="steps">
        <li><strong>Medical care first.</strong> Injured people should document symptoms and follow-up care.</li>
        <li><strong>Information is collected.</strong> Medical records, photos, and reports are gathered to understand what happened.</li>
        <li><strong>Claims are presented.</strong> In some cases, a written summary of injuries and damages is provided to an insurance company.</li>
        <li><strong>Settlement discussions occur. </strong>Insurance companies may make offers before any lawsuit is filed.</li>
      </ol>
    </div>
  </section>
</main>


    <Footer />

    <style>
      ...
    </style>
  </body>
</html>
