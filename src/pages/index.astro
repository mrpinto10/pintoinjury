---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1>Personal Injury Guidance Before a Lawsuit Is Filed</h1>
      <p class="subhead">
        Clear, practical legal information and representation for injured people in
        <strong>Ontario, Upland, and Rancho Cucamonga, California</strong>.
      </p>

      <ul class="bullets">
        <li>Focused on <strong>pre-litigation</strong> injury claims</li>
        <li>Straightforward explanations of the <strong>insurance process</strong></li>
        <li>Local knowledge of <strong>California injury law</strong></li>
        <li>No obligation, no pressure conversations</li>
      </ul>

      <div class="cta">
        <a class="button" href="/contact">Get Clear Information About Your Injury</a>
        <a class="link" href="/resources">Browse injury resources &rarr;</a>
      </div>

      <p class="fineprint">
        Information on this site is general and not legal advice. No attorney–client relationship is created by use of
        this website.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container">
      <h2>How Pre-Litigation Injury Claims Typically Work</h2>
      <ol class="steps">
        <li><strong>Medical care first.</strong> Document your symptoms and follow-up care.</li>
        <li><strong>Investigation.</strong> We gather records, photos, reports, and other evidence.</li>
        <li><strong>Demand package.</strong> A clear summary of liability and damages is sent to the insurer.</li>
        <li><strong>Negotiation.</strong> We evaluate offers and discuss options before any lawsuit is filed.</li>
      </ol>
    </div>
  </section>
</main>


    <Footer />

    <style>
      ...
    </style>
  </body>
</html>
